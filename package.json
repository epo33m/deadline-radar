{
  "name": "deadline-radar",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --env-file=.env.local run scripts/dev.ts .env.local",
    "dev:web": "bun --env-file=$PWD/.env.local run --cwd apps/web dev",
    "dev:api": "bun --env-file=$PWD/.env.local run --cwd apps/api --watch src/index.ts",
    "dev:staging": "bun --env-file=.env.staging run scripts/dev.ts .env.staging",
    "seed:staging": "bun --env-file=.env.staging run scripts/seed-staging.ts",
    "build": "bunx nx run-many -t build --projects=web,api",
    "lint": "bunx nx run-many -t lint",
    "typecheck": "bunx nx run-many -t typecheck --projects=web,api,db,domain,validation,e2e",
    "test": "bunx nx run-many -t test",
    "pretest:e2e": "bun run --filter e2e with-target-env -- nx run-many -t build --projects=web",
    "test:e2e": "bun run --filter e2e test:e2e",
    "openapi:generate": "bun run --filter web generate-api",
    "db:migrate": "bun --env-file=.env.local run scripts/migrate.ts up",
    "db:status": "bun --env-file=.env.local run scripts/migrate.ts status",
    "db:verify": "bun --env-file=.env.local run scripts/migrate.ts verify",
    "db:drift": "bun --env-file=.env.local run scripts/verify-schema-drift.ts",
    "db:migrate:staging": "bun --env-file=.env.staging run scripts/migrate.ts up",
    "db:status:staging": "bun --env-file=.env.staging run scripts/migrate.ts status",
    "db:verify:staging": "bun --env-file=.env.staging run scripts/migrate.ts verify",
    "db:drift:staging": "bun --env-file=.env.staging run scripts/verify-schema-drift.ts"
  },
  "devDependencies": {
    "@nx/js": "21.5.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "nx": "21.5.2",
    "typescript": "5.9.2"
  }
}
