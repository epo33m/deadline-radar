{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p .",
    "lint": "echo 'lint: no linter configured for api — static gate is typecheck (web runs eslint)'",
    "openapi": "bun run src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@deadline-radar/db": "workspace:*",
    "@deadline-radar/domain": "workspace:*",
    "@deadline-radar/validation": "workspace:*",
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/openapi": "^1.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "drizzle-orm": "0.45.2",
    "elysia": "^1.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.0.11",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@sentry/bun": "^10.75.0",
    "@types/bun": "^1.4.0",
    "@types/ioredis": "^5.0.0",
    "openapi-types": "^12.1.3",
    "typescript": "5"
  },
  "nx": {
    "targets": {
      "dev": {
        "continuous": true
      }
    }
  }
}
