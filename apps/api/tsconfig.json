{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["bun"],
    "noEmit": true,
    "jsx": "preserve",
    "paths": {
      "@deadline-radar/db": ["../../packages/db/src/index.ts"],
