    "/api/v1/attachments/file": {
      "post": {
        "tags": [
          "Attachments"
        ],
        "summary": "Upload file attachment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "file"
                ],
                "properties": {
                  "task_id": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "file": {
                    "default": "File",
                    "type": "string",
                    "maxSize": "10m",
                    "extension": [
                      "application/pdf",
                      "image/png",
                      "image/jpeg",
                      "image/webp",
                      "image/gif",
                      "text/plain",
                      "application/msword",
                      "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                    ],
                    "format": "binary"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "file"
                ],
                "properties": {
                  "task_id": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "file": {
                    "default": "File",
                    "type": "string",
                    "maxSize": "10m",
                    "extension": [
                      "application/pdf",
                      "image/png",
                      "image/jpeg",
                      "image/webp",
                      "image/gif",
                      "text/plain",
                      "application/msword",
                      "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                    ],
                    "format": "binary"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "file"
                ],
                "properties": {
                  "task_id": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "file": {
                    "default": "File",
                    "type": "string",
                    "maxSize": "10m",
                    "extension": [
                      "application/pdf",
                      "image/png",
                      "image/jpeg",
                      "image/webp",
                      "image/gif",
                      "text/plain",
                      "application/msword",
                      "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                    ],
                    "format": "binary"
                  }
                }
              }
            }
          }
