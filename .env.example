# Copy to `.env.local` and fill in from your Supabase project:
# Project Settings → API

# Project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon / public key (Project Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key (Project Settings → API → Project API keys → service_role)
# Server-only — never expose to the browser. Needed later for the reminder
# scheduler (#9); optional for local auth (#4) but fine to set now.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
