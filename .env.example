# Root env for local monorepo (apps/web + apps/api).
# Copy to `.env.local` and fill from Supabase + Resend.

# --- Shared / API ---
# Postgres via Supabase shared transaction-mode pooler (IPv4). Replace [YOUR-PASSWORD].
# prepare: false is required for this pool mode (already set in packages/db).
DATABASE_URL="postgresql://postgres.gejhqrwqtieupiweyskp:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres"

# Prefer these for the Elysia API (falls back to NEXT_PUBLIC_* if unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT Secret — optional legacy HS256 fallback.
# New Supabase projects sign with ES256; the API verifies via JWKS automatically.
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret

# Web origin (cookie/CORS). API listens on API_PORT.
WEB_ORIGIN=http://127.0.0.1:3025
API_ORIGIN=http://127.0.0.1:4025
API_PORT=4025

# Resend — email reminder delivery
RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Deadline Radar <onboarding@resend.dev>

# Protects GET /api/v1/cron/evaluate-reminders (Authorization: Bearer …)
# Required except in NODE_ENV=test.
CRON_SECRET=generate-a-long-random-string

# Shared secret for Next server → API auth bridge (x-dr-auth-bridge header).
# Must match on web and api. Never use the literal value "1".
AUTH_BRIDGE_SECRET=generate-another-long-random-string

# Optional Redis URL for multi-node rate limiting. Unset → in-memory (dev).
# REDIS_URL=redis://127.0.0.1:6379

# Trust X-Forwarded-For / X-Real-IP only behind a known reverse proxy.
# TRUST_PROXY=true

# --- Web (Next.js) ---
# Kept for any remaining client/env reads; API prefers SUPABASE_* above.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
