# Copy to `.env.local` and fill in from your Supabase project:
# Project Settings → API

# Project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon / public key (Project Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key (Project Settings → API → Project API keys → service_role)
# Server-only — never expose to the browser. Required for the reminder
# scheduler (#9).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com) — email reminder delivery (#9)
RESEND_API_KEY=re_xxxxxxxx
# Optional; defaults to Resend onboarding sender for local/dev
# RESEND_FROM_EMAIL=Deadline Radar <onboarding@resend.dev>

# Protects /api/cron/evaluate-reminders (Vercel Cron sends Authorization: Bearer …)
# Required in production; optional locally (NODE_ENV !== production allows open access).
CRON_SECRET=generate-a-long-random-string
